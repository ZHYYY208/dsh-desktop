#!/bin/sh
# DSH Desktop launcher: runs the bundled dsh CLI with the bundled Node.js.
set -e

APP_ROOT=/opt/dsh-desktop

if [ ! -x "$APP_ROOT/node/bin/node" ]; then
  echo "dsh-desktop: bundled Node.js not found at $APP_ROOT/node/bin/node" >&2
  exit 1
fi

exec "$APP_ROOT/node/bin/node" "$APP_ROOT/app/node_modules/@deepseek-ai/dsh/lib/bin.js" "$@"
